#!/usr/bin/env bpftrace
/*
 * sensitive_write_watch.bt
 *
 * Watches openat(2) calls that target a short, explicit allowlist of
 * sensitive paths under /proc/sys and /sys, requesting write access
 * (O_WRONLY=1 or O_RDWR=2). This is deliberately a path allowlist, not a
 * prefix match over all of /proc/sys or /sys, because those trees are read
 * constantly by completely ordinary tools (sysctl, udev, monitoring agents)
 * and a prefix match would be pure noise -- the same lesson the capability
 * script's false-positive section makes about cap_capable.
 *
 * Paths chosen because they are the specific knobs real container-escape and
 * privilege-abuse writeups target:
 *   /proc/sys/kernel/core_pattern   - classic root-shell-via-crash-handler path
 *   /proc/sys/kernel/modprobe       - kernel module autoload trigger path
 *   /sys/fs/cgroup/.../release_agent - cgroup v1 escape path (does not exist on
 *                                      this host's cgroup v2 setup, per the
 *                                      sibling ai-infra-redteam/container
 *                                      project's finding; matched here anyway
 *                                      so the detector would catch it if this
 *                                      script ever runs on a v1 host)
 *   /proc/sysrq-trigger              - can force a kernel panic/reboot/etc
 *
 * FIRST DRAFT MISTAKE #1, LEFT DOCUMENTED RATHER THAN QUIETLY FIXED: the
 * first version of this filter matched any path with the PREFIX
 * /sys/fs/cgroup/, intending to catch a release_agent write anywhere in the
 * cgroup tree. Live testing against a single `docker run` showed this was
 * wrong: systemd itself writes ~19 ordinary accounting files (cpu.weight,
 * memory.max, pids.max, cgroup.procs, etc) into a container's OWN new
 * cgroup scope every time any container starts, and containerd-shim writes
 * cgroup.subtree_control too. Both are completely normal. The filter below
 * matches only paths CONTAINING the literal substring "release_agent",
 * instead of the whole subtree.
 *
 * FIRST DRAFT MISTAKE #2, same treatment: the first version only hooked
 * sys_enter_openat. Live-testing it against
 * `docker run --privileged alpine sh -c 'echo core > /proc/sys/kernel/core_pattern'`
 * produced zero events even though the write demonstrably succeeded (exit
 * code 0, and a follow-up `cat` read back the new value). Direct tracing
 * showed why: busybox's `sh` calls the legacy open(2) syscall for shell
 * redirection, not openat(2). Which syscall a program uses to open a file is
 * a libc/binary implementation detail the defender does not control, so this
 * script hooks both.
 */

BEGIN
{
	printf("%-8s %-8s %-20s %-6s %-8s %s\n", "TIME", "PID", "COMM", "MODE", "SYSCALL", "PATH");
}

tracepoint:syscalls:sys_enter_openat
/(args->flags & 3) == 1 || (args->flags & 3) == 2/
{
	$path = str(args->filename);
	if ($path == "/proc/sys/kernel/core_pattern" ||
	    $path == "/proc/sys/kernel/modprobe" ||
	    $path == "/proc/sysrq-trigger" ||
	    strcontains($path, "release_agent")) {
		printf("%-8u %-8d %-20s %-6s %-8s %s\n",
			elapsed / 1000000, pid, comm,
			(args->flags & 3) == 1 ? "WR" : "RDWR", "openat", $path);
	}
}

tracepoint:syscalls:sys_enter_open
/(args->flags & 3) == 1 || (args->flags & 3) == 2/
{
	$path = str(args->filename);
	if ($path == "/proc/sys/kernel/core_pattern" ||
	    $path == "/proc/sys/kernel/modprobe" ||
	    $path == "/proc/sysrq-trigger" ||
	    strcontains($path, "release_agent")) {
		printf("%-8u %-8d %-20s %-6s %-8s %s\n",
			elapsed / 1000000, pid, comm,
			(args->flags & 3) == 1 ? "WR" : "RDWR", "open", $path);
	}
}
