#!/usr/bin/env bpftrace
/*
 * ptrace_watch.bt
 *
 * Watches ptrace(2) requests. Verified live with `gdb -p 1 -batch -ex detach`:
 * PTRACE_ATTACH is request 16, PTRACE_SEIZE is 0x4206, PTRACE_DETACH is 17
 * (values from /usr/include/linux/ptrace.h on this box). This script flags
 * ATTACH and SEIZE specifically, since those are the requests a process uses
 * to attach to a process it did not start itself -- the cross-process-boundary
 * behavior the task asked for -- as opposed to PTRACE_TRACEME (0), which a
 * process issues on itself and is unremarkable (every debugger-launched child
 * does this).
 */

BEGIN
{
	printf("%-8s %-8s %-20s %-6s %-8s %s\n", "TIME", "PID", "COMM", "PID", "TARGET", "REQUEST");
}

tracepoint:syscalls:sys_enter_ptrace
/args->request == 16 || args->request == 0x4206/
{
	printf("%-8u %-8d %-20s %-6d %-8d %s\n",
		elapsed / 1000000, pid, comm, pid, args->pid,
		args->request == 16 ? "PTRACE_ATTACH" : "PTRACE_SEIZE");
}
