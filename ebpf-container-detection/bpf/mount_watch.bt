#!/usr/bin/env bpftrace
/*
 * mount_watch.bt
 *
 * Watches mount(2) and pivot_root(2) calls. Verified live: a normal
 * `docker run` produces roughly 20 mount syscalls (overlay2 merged-dir bind
 * mount, procfs, tmpfs, devpts, sysfs, cgroup2, mqueue, shm, resolv.conf/
 * hostname/hosts bind mounts) and exactly one pivot_root, all from a process
 * named "runc:[2:INIT]". That volume and pattern is the CONTROL baseline this
 * script's own README documents. What matters for detection is not "a mount
 * happened" (that is normal container startup) but a mount or pivot_root
 * happening from a PID that already looks like a running container's own
 * workload (not runc/containerd/dockerd), which is what a container escape
 * mounting the host filesystem into itself, or performing a second pivot_root
 * after startup, would look like.
 */

BEGIN
{
	printf("%-8s %-8s %-20s %-10s %s\n", "TIME", "PID", "COMM", "SYSCALL", "DETAIL");
}

tracepoint:syscalls:sys_enter_mount
{
	$is_runtime = (comm == "runc" || comm == "runc:[1:CHILD]" || comm == "runc:[2:INIT]" ||
		comm == "containerd" || comm == "containerd-shim" || comm == "dockerd");
	printf("%-8u %-8d %-20s %-10s src=%s dst=%s fstype=%s%s\n",
		elapsed / 1000000, pid, comm, "mount",
		str(args->dev_name), str(args->dir_name), str(args->type),
		$is_runtime ? "" : "  <-- NOT container runtime, worth review");
}

tracepoint:syscalls:sys_enter_pivot_root
{
	$is_runtime = (comm == "runc" || comm == "runc:[1:CHILD]" || comm == "runc:[2:INIT]");
	printf("%-8u %-8d %-20s %-10s new_root=%s put_old=%s%s\n",
		elapsed / 1000000, pid, comm, "pivot_root",
		str(args->new_root), str(args->put_old),
		$is_runtime ? "" : "  <-- NOT container runtime, worth review");
}
