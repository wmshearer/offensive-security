# A small model-inference service, of the shape a company would actually ship.
#
# Nothing here is contrived for the exercise. It is a Python base image, a web
# framework, an HTTP client, and the gguf library that reads model files. That
# last one is the reason this image exists: gguf-py is the parser I found a bug
# in and reported upstream as llama.cpp PR #28131, so this is a chance to ask the
# product-security question about a component I actually know is affected.
FROM python:3.11-slim

WORKDIR /app

# Pinned, because an exposure assessment against floating versions tells you
# nothing you can act on a week later.
RUN pip install --no-cache-dir \
      gguf==0.19.0 \
      fastapi==0.115.0 \
      uvicorn==0.32.0 \
      requests==2.32.3 \
      numpy==2.1.3

COPY serve.py /app/serve.py

EXPOSE 8000
CMD ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8000"]
